<?xml version="1.0" encoding="UTF-8"?>
<!--
    Arquillian connects to an ALREADY-RUNNING GlassFish instance (the
    "remote" container type — Arquillian does not start/stop GlassFish
    itself here) via its admin port. Replace the placeholder values below
    with the target environment's actual admin host/port/credentials
    before running `mvn verify` — see docs/DEPLOYMENT_GUIDE.md, "Running
    the integration tests", for the full setup (starting GlassFish,
    loading db/schema.sql, adding jdbc/SCMDataSource via
    deploy/glassfish-resources.xml) that must happen before this
    configuration is usable.
-->
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="glassfish" default="true">
        <configuration>
            <property name="adminHost">localhost</property>
            <property name="adminPort">4848</property>
            <property name="adminUser">admin</property>
            <property name="adminPassword">CHANGE_ME</property>
            <property name="target">server</property>
        </configuration>
    </container>
</arquillian>
